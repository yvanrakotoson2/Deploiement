<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="inherit_view_purchase_view_order_form" model="ir.ui.view">
            <field name="name">purchase.order.form.advance.payment</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//header//button[@name='button_draft']" position="before">
                    <button name="btn_advance_payment" string="Advance Payment"
                        type="object" class="btn-primary" groups="account.group_account_invoice"
                        invisible="state in ['draft', 'cancel']" />
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_adv_payments" type="object" class="oe_stat_button"
                        icon="fa-money" groups="account.group_account_invoice" invisible="adv_payment_count == 0">
                        <field name="adv_payment_count" widget="statinfo" string="Adv. Payments" />
                    </button>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_advance_account_payment_form" model="ir.ui.view">
            <field name="name">purchase.advance.payment.form</field>
            <field name="model">account.payment</field>
            <field name="arch" type="xml">
                <form string="Advance Payment">
                    <sheet>
                        <group>
                            <group>
                                <field name="payment_type" readonly="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <label for="amount"/>
                                <div name="amount_div" class="o_row">
                                    <field name="amount"/>
                                    <field
                                        name="currency_id"
                                        options="{'no_create': True, 'no_open': True}"
                                        required="1"
                                    />
                                </div>
                                <field
                                    name="journal_id"
                                    domain="[('type', 'in', ['bank', 'cash'])]"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                                <field
                                    name="payment_method_line_id"
                                    options="{'no_create': True, 'no_open': True}"
                                />
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button
                            name="action_post"
                            string="Advance Payment"
                            type="object"
                            class="oe_highlight"
                        />
                        <button
                            special="cancel"
                            class="btn-secondary"
                            string="Close"
                        />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>